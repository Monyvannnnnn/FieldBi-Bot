# ============================================================
# Telegram Support Bot Environment Configuration Template
# ============================================================

# Database Driver (mysql or pgsql)
DB_DRIVER=pgsql

# PostgreSQL / Supabase Database Credentials
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=YOUR_POSTGRES_USER
DB_PASS=YOUR_POSTGRES_PASSWORD

# Full Database Connection String
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:6543/postgres

# Local MySQL Credentials (Fallback)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASS=
MYSQL_NAME=inventory

# Telegram Support Bot Credentials
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ADMIN_CHAT_ID=YOUR_TELEGRAM_ADMIN_CHAT_ID

# Company Personal Telegram Link (Optional)
COMPANY_TELEGRAM_LINK=https://t.me/your_username
