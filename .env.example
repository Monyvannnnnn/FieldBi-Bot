# ============================================================
# Telegram Support Bot Environment Configuration Template
# ============================================================

# Database Driver (mysql for local XAMPP, or pgsql for Supabase)
DB_DRIVER=mysql

# Local MySQL Credentials (XAMPP Default)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=
MYSQL_NAME=telegram_support_db

# PostgreSQL / Supabase Credentials (If using pgsql)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=

# Telegram Support Bot Credentials
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ADMIN_CHAT_ID=YOUR_TELEGRAM_ADMIN_CHAT_ID

# Company Personal Telegram Link (Optional)
COMPANY_TELEGRAM_LINK=https://t.me/your_username
